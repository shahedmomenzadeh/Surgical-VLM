# ============================================================
# Environment Variables for Training Pipeline (SFT & GRPO)
# ============================================================
# Copy this file to .env and configure your environment:
#   cp .env.example .env

# Hugging Face Access Token (for gated model downloads and checkpoints)
HF_TOKEN=""

# WandB Logging (optional)
WANDB_API_KEY=""
WANDB_PROJECT="qwen3-vl-cataract-training"

# Dataset root directories (defaults resolve automatically inside this folder)
# SFT_DATASET_ROOT="dataset_sft"
# GRPO_DATASET_ROOT="dataset_grpo"

# Cache directory for Hugging Face weights
# HF_HOME="./hf_cache"

# ============================================================
# Environment Variables for Surgical Video-to-Report Framework
# ============================================================
# Copy this file to .env and configure endpoints and credentials:
#   cp .env.example .env

# Hugging Face Access Token (for uploading or accessing leaderboard datasets)
HF_TOKEN=""

# Teacher VLM API Configuration (e.g. Gemini via OpenAI-compatible proxy)
TEACHER_BASE_URL="http://localhost:20128/v1"
TEACHER_API_KEY="none"
TEACHER_MODEL="ag/gemini-3.8-flash"

# Evaluation Judge Configuration
JUDGE_BASE_URL="http://localhost:20128/v1"
JUDGE_API_KEY="none"
JUDGE_MODEL="ag/gemini-3.8-flash"
